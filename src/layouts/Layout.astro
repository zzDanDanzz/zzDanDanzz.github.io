---
import "@/index.css";
import { Header } from "@/components/Header";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Daniel's Portfolio",
    description = "Portfolio of Daniel Zahmatkesh, a Lead Front-End Developer specializing in React, complex state management, and geospatial web platforms.",
} = Astro.props;

const locale = Astro.currentLocale || 'en';
const dir = locale === 'fa' ? 'rtl' : 'ltr';
---

<!doctype html>
<html lang={locale} dir={dir}>
    <head>
        <meta charset="UTF-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link
            rel="preload"
            href="/fonts/inter-latin-wght-normal.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <script is:inline>
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        </script>
        <slot name="head" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="author" content="Daniel Zahmatkesh" />

        <meta
            property="og:title"
            content="Daniel Zahmatkesh | Lead Front-End Developer"
        />
        <meta
            property="og:description"
            content="Specializing in React applications, offline-first architectures, and interactive WebGIS platforms."
        />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://zahmatkesh.com/" />
        <meta
            property="og:image"
            content="https://github.com/zzdandanzz.png?size=600"
        />

        <meta name="twitter:card" content="summary" />
        <meta
            name="twitter:title"
            content="Daniel Zahmatkesh | Lead Front-End Developer"
        />
        <meta
            name="twitter:description"
            content="Specializing in React applications, offline-first architectures, and interactive WebGIS platforms."
        />
        <meta
            name="twitter:image"
            content="https://github.com/zzdandanzz.png?size=600"
        />
    </head>
    <body>
        <div
            class="relative flex w-full flex-col bg-background text-foreground transition-colors duration-300 min-h-screen"
        >
            <Header locale={locale} currentPath={Astro.url.pathname} client:load />
            <slot />
        </div>
    </body>
</html>
